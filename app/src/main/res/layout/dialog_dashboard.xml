<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数据总览"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 月份切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDashPrevMonth"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:backgroundTint="@color/teal"
            android:text="◀"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvDashMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDashNextMonth"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:backgroundTint="@color/teal"
            android:text="▶"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 周切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDashPrevWeek"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:backgroundTint="@color/teal"
            android:text="◀"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvDashWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDashNextWeek"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:backgroundTint="@color/teal"
            android:text="▶"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/dashboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnLedgerOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#C2410C"
        android:text="账本总览"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCloseDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#94A3B8"
        android:text="关闭"
        android:textColor="#FFFFFF" />
</LinearLayout>
